{
  "name": "moirai",
  "private": true,
  "version": "0.0.0",
  "description": "Emergent civilisation: agents that evolve verifiable skills on 0G + AXL",
  "type": "module",
  "engines": { "node": ">=20" },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter @moirai/engine dev",
    "smoke": "pnpm --filter @moirai/engine smoke",
    "sim": "pnpm --filter @moirai/engine sim"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2"
  }
}
