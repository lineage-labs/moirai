# 0G Network — chain RPC and wallet
# Testnet:
ZG_RPC_URL=https://evmrpc-testnet.0g.ai
# Mainnet:
# ZG_RPC_URL=https://evmrpc.0g.ai

# Wallet private key. NEVER commit. Required for both Compute and Storage.
ZG_PRIVATE_KEY=0x...

# --- Funding (required for real-network spikes) ---
# 0G Compute: creating a ledger needs >= 3 0G on-chain (broker.ledger.addLedger).
# After that, transfer funds to a provider inference sub-account for sealed inference.
# 0G Storage: uploads pay native storage fee (msg.value) + gas; fund the same wallet on this chain.
# Public faucet is often ~0.1 0G/day — for hackathons, request testnet 0G via 0G Discord / team faucet.

# 0G Storage indexer URL (must match ZG_RPC_URL network: testnet vs mainnet).
# Prefer standard indexer for lower fees when testing small blobs:
#   https://indexer-storage-testnet-standard.0g.ai
# Turbo (higher fees):
#   https://indexer-storage-testnet-turbo.0g.ai
ZG_INDEXER_URL=https://indexer-storage-testnet-standard.0g.ai

# 0G Compute optional pinning. If unset, the adapter auto-picks the cheapest
# TeeML provider for verifiable calls.
# ZG_PROVIDER_ADDRESS=0x...
# ZG_MODEL=

# Optional: 0G (whole tokens) to transfer from main ledger to the inference provider sub-account
# after ledger creation (default in spike/adapter: 1).
# ZG_INFERENCE_TRANSFER_OG=1

# AXL — one HTTP base URL per axl-pubsub Gossip instance. For integration tests / spikes that
# need whisper/broadcast delivery, run a 3-node mesh (see docs/kernel/working-with-kernel.md)
# and set all three. Defaults below match docker-compose.axl.yml (host ports 19002/19012/19022).
# We use 19xxx so the mesh never collides with a standalone AXL daemon you may already have on 9002.
AXL_URL_1=http://127.0.0.1:19002
AXL_URL_2=http://127.0.0.1:19012
AXL_URL_3=http://127.0.0.1:19022
# Back-compat: a single AXL_URL is still used as fallback when _1/_2/_3 are unset
# (e.g. for the spike's single-node smoke against a standalone daemon on 9002).
# AXL_URL=http://127.0.0.1:9002

# Fallback LLM for non-verifiable calls or when 0G Compute is down.
# Leave unset to disable the fallback path (sealed errors will surface).
# FALLBACK_PROVIDER=anthropic
# FALLBACK_API_KEY=
# FALLBACK_MODEL=claude-haiku-4-5-20251001
# FALLBACK_BASE_URL=
