# 0G Network — chain RPC and wallet
# Testnet:
ZG_RPC_URL=https://evmrpc-testnet.0g.ai
# Mainnet:
# ZG_RPC_URL=https://evmrpc.0g.ai

# Wallet private key. NEVER commit. Required for both Compute and Storage.
ZG_PRIVATE_KEY=0x...

# 0G Storage indexer URL.
# Testnet (turbo):    https://indexer-storage-testnet-turbo.0g.ai
# Testnet (standard): https://indexer-storage-testnet-standard.0g.ai
ZG_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai

# 0G Compute optional pinning. If unset, the adapter auto-picks the cheapest
# TeeML provider for verifiable calls.
# ZG_PROVIDER_ADDRESS=0x...
# ZG_MODEL=

# Fallback LLM for non-verifiable calls or when 0G Compute is down.
# Leave unset to disable the fallback path (sealed errors will surface).
# FALLBACK_PROVIDER=anthropic
# FALLBACK_API_KEY=
# FALLBACK_MODEL=claude-haiku-4-5-20251001
# FALLBACK_BASE_URL=
